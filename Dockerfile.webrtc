# Build image for the ad_gateway `webrtc` feature (the native SIP<->WebRTC
# participant). The livekit SDK pulls libwebrtc, whose hermetic libc++ requires
# clang 21+ (Debian bookworm ships clang 14), so we install LLVM 21 and point
# CC/CXX at it. This image compiles the webrtc_bridge_probe example used by the
# WebRTC e2e.
FROM rust:1.90-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates pkg-config libssl-dev python3 libglib2.0-dev \
      wget gnupg lsb-release software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# LLVM/clang 21 (required by the libwebrtc hermetic libc++).
RUN wget -qO /tmp/llvm.sh https://apt.llvm.org/llvm.sh \
    && chmod +x /tmp/llvm.sh \
    && /tmp/llvm.sh 21 \
    && rm -rf /var/lib/apt/lists/*

ENV CC=clang-21 CXX=clang++-21
ENV CARGO_TERM_COLOR=never
WORKDIR /app
