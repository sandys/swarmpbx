<?xml version="1.0" encoding="ISO-8859-1" ?>
<!-- UAS: answer the outbound call LiveKit places via our gateway, then stream
     PCMA audio so the agent in the room receives frames. This is the "callee"
     that our orchestrator-originated call reaches. -->
<scenario name="uas-answer-and-play">
  <recv request="INVITE" crlf="true"/>

  <send>
    <![CDATA[
      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8
      a=rtpmap:8 PCMA/8000
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true"/>

  <!-- Stream PCMA audio for the agent to receive, then stay up briefly. -->
  <nop>
    <action>
      <exec play_pcap_audio="/sipp/g711a.pcap"/>
    </action>
  </nop>
  <pause milliseconds="6000"/>

  <recv request="BYE" timeout="8000" ontimeout="label_end"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <label id="label_end"/>
</scenario>
